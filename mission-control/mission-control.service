[Unit]
Description=Mission Control Next.js app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=davesalter
WorkingDirectory=/home/davesalter/.openclaw/workspace/mission-control
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3010
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
